# 7-Zip (nmake / MSVC / GCC / Clang)
# Do not ignore Asm/{x86,arm,arm64} — those hold assembler sources.

# Pack / install output (pack.ps1 copies binaries here)
/OUT/

# Per-target nmake output dirs (O=$(PLATFORM), default O=o)
x64/
x64con/
o/

# GCC/Clang object dirs (O=b/g_x64, b/m_arm64, …)
b/

